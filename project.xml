<?xml version="1.0" encoding="utf-8"?>
<project>
	
	<meta title="BambaMagicKeep" package="com.sample.bambamagickeep" version="1.0.0" company="Company Name" />
	<app main="BambaMain" path="Export" file="BambaMagicKeep" />

	<!-- Game icon: lime auto-generates .ico (Windows), .icns (Mac) and the Switch NRO's
	     icon from this one PNG, by resampling to each platform's size set. Square source
	     with transparent background is best. -->
	<icon path="icon.png" />
	
	<!-- 1041x720 is the authored 940x650 stage scaled up at its exact aspect ratio, so the game
	     fills the window edge to edge at that size; any other size rescales it and centres it
	     (BambaMain.fitToStage). -->
	<!-- allow-high-dpi: lime's mac target forces this off by default, which renders at window-point
	     resolution and lets the OS upscale the result. On, OpenFL rasterises vectors and text at the
	     real device resolution (Graphics.__update takes its scale from the display matrix). This is
	     a no-op on a non-HiDPI monitor - window.scale is 1 - and a clear win on a Retina one.
	     Bitmap filtering is a separate matter, handled by utils.BitmapSmoothing. -->
	<window width="1041" height="720" resizable="true" background="#000000" allow-high-dpi="true" unless="switch"/>
	<!-- Frame rate: vsync paces it to the monitor (60, 144, 240 Hz...); fps is only the ceiling.
	     Timeline art still steps at its authored 12-30 fps; time-based motion (tweens, the tower
	     scroll in BambaTower) gets smoother. -->
	<window fps="240" vsync="true" />
	<!-- Desktop builds start fullscreen at the monitor's resolution; fitToStage scales the game to
	     it. F11 toggles back to a window (BambaMain.onStageKeyDown). Disabled for now - uncomment
	     to start fullscreen again.
	<window fullscreen="true" if="desktop" unless="switch" /> -->

	<!-- Nintendo Switch homebrew, via the lime-nx fork (https://github.com/Slushi-Github/lime-nx).
	     Target name is "switch", built with `haxelib run lime build switch`; requires that fork's
	     lime/hxcpp haxelibs installed locally, which this project does not set up on its own. -->
	<haxedef name="lime-opengl" if="switch" />
	<haxedef name="lime-cairo" value="false" if="switch" />
	<set name="LIME_CAIRO" value="0" if="switch" />
	<set name="LIME_OPENGL" value="1" if="switch" />
	<window if="switch" orientation="landscape" fullscreen="true" width="0" height="0" resizable="false" hardware="true" />

	<source path="Source" />
	<haxelib name="openfl" />
	<haxelib name="actuate" />
	<haxelib name="swf" />
	<haxelib name="format" />
	<haxelib name="haxeui-core" />
	<haxelib name="haxeui-openfl" />
	<assets path="Assets" rename="assets" exclude="*.mp3" /> <!-- mp3 kept as source only: lime cannot decode mp3 on native targets, the game loads the .ogg copies -->
	<assets path="Assets/splash.png" rename="assets/splash.png" preload="true" /> <!-- Studio splash: preloaded so utils.StudioIntro can show it before BambaLoader starts. -->
	<assets path="assets/intro/IntroBamba.zip" embed="false" id="IntroBamba" /> <!-- converted from IntroBamba.swf via `haxelib run swf generate`: OpenFL has no runtime SWF parser on native -->
	<assets path="assets/swf/OpeningAssets.swf" preload="true" generate="true"  />
	<assets path="assets/openingAssets/openingAssets.zip" preload="true" id="openingAssets"/> 
	<assets path="assets/game_assets/general.zip" generate="true" id="general.swf"/>
	<assets path="assets/game_assets/newPlayer.zip" generate="true" id="newPlayer.swf"/>
	<assets path="assets/game_assets/towerScreens_mod.zip" generate="true" id="towerScreens.swf"/>
	<assets path="assets/game_assets/menu.zip" generate="true" id="menu.swf"/>
	<assets path="assets/game_assets/cards.zip" generate="true" id="cards.swf"/>
	<assets path="assets/game_assets/items.zip" generate="true" id="items.swf"/>
	<assets path="assets/game_assets/mapGraphics.zip" generate="true" id="mapGraphics.swf"/>
	<assets path="assets/game_assets/baby.zip" generate="true" id="baby.swf"/>
	<assets path="assets/game_assets/fightGraphics.zip" generate="true" id="fightGraphics.swf"/>
	<assets path="assets/game_assets/dungeonGraphics.zip" generate="true" id="dungeonGraphics.swf"/>
	<assets path="assets/game_assets/help.zip" generate="true" id="help.swf"/>
