	<assets path="assets/fonts/Arial.ttf" id="Arial" embed="true" />
	<!-- "Arial Bold": 21 tower-screen fields ask for it by name. This is Windows' arialbd.ttf with
	     its family renamed to "Arial Bold" by tools/rename_font_family.py: lime registers a font
	     under its family name, and the stock file's family is "Arial", which would replace the
	     regular face and turn every Arial field bold. -->
	<assets path="assets/fonts/Arial_Bold.ttf" id="Arial Bold" embed="true" />
	<assets path="assets/fonts/Choco.ttf" id="Choco" embed="true" />
	<assets path="assets/fonts/Choco_Bold.ttf" id="Choco Bold" embed="true" />
	<assets path="assets/fonts/Footlight_MT_Light.ttf" id="Footlight MT Light" embed="true" />
	<!-- Petel (Meir Sadan, oketz.com - free Hebrew font, see Assets/fonts/Petel-license.txt).
	     The regular weight only: nothing in the libraries asks for "Petel Bold". Its internal
	     family name is already "Petel", which is what the SWFs request, so utils.FontBinder
	     matches it exactly - the id below plays no part in that. -->
	<assets path="assets/fonts/Petel.ttf" id="Petel" embed="true" />
